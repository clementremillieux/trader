[Unit]
Description=Trader bot service
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/clement/trader
ExecStart=/home/clement/trader/start_trader.sh
Restart=always
RestartSec=5

StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=trader-bot

[Install]
WantedBy=multi-user.target
